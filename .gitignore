# gitignore template for Drupal 8 projects
#
# earlier versions of Drupal are tracked in `community/PHP/`
#
# follows official upstream conventions:
# https://www.drupal.org/docs/develop/using-composer

# Ignore configuration files that may contain sensitive information
/web/sites/*/*settings*.php
/web/sites/*/*services*.yml

# Ignore paths that may contain user-generated content
/web/sites/*/files
/web/sites/*/public
/web/sites/*/private
/web/sites/*/files-public
/web/sites/*/files-private

# Ignore paths that may contain temporary files
/web/sites/*/translations
/web/sites/*/tmp
/web/sites/*/cache

# Ignore drupal core (if not versioning drupal sources)
/web/vendor
/web/core
/web/modules/README.txt
/web/modules/contrib
/web/profiles/README.txt
/web/profiles/contrib
/web/sites/development.services.yml
/web/sites/example.settings.local.php
/web/sites/example.sites.php
/web/sites/README.txt
/web/themes/README.txt
/web/themes/contrib
/web/.csslintrc
/web/.editorconfig
/web/.eslintignore
/web/.eslintrc.json
/web/.gitattributes
/web/.htaccess
/web/.ht.router.php
/web/autoload.php
/web/composer.json
/web/composer.lock
/web/example.gitignore
/web/index.php
/web/INSTALL.txt
/web/LICENSE.txt
/web/README.txt
/web/robots.txt
/web/update.php
/web/web.config

# Ignore vendor dependencies and scripts
/vendor
/composer.phar
/composer
/robo.phar
/robo
/drush.phar
/drush
/drupal.phar
/drupal

# ===== SO-ARM ポータル固有 =====
# .env には秘密情報が入りうるためコミットしない（.env.production なども含む）。
# 見本だけは追跡する（.dockerignore と揃える）
.env
.env.*
!.env.example
!.env.sample

# Claude Code の個人設定（.claude/agents/ などの共有する定義は追跡する）
/.claude/settings.local.json
/CLAUDE.local.md

# 鍵（simple_oauth の RSA 鍵など）
*.key
*.pem

# DB ダンプ（drush sql:dump の出力。ユーザーのパスワードハッシュを含む）
*.sql
*.sql.gz

# 大容量データ（LeRobot のデータセットや動画）。小さなテスト用 fixture だけ許可する
*.mp4
*.h5
*.hdf5
*.parquet
!tests/fixtures/**

# 将来の React / Vue、Python の仮想環境
node_modules/
.venv/

# web/ 配下は custom のコードだけ追跡し、core / contrib / sites はイメージ側にある
/web/*
!/web/modules/
/web/modules/*
!/web/modules/custom/
!/web/themes/
/web/themes/*
!/web/themes/custom/

# MySQL / MariaDB のデータ・ダンプ（バインドマウント）
/mysql/

# Python
__pycache__/
*.pyc
.pytest_cache/

# OS / エディタ / ログ
.DS_Store
Thumbs.db
*.swp
*~
.idea/
.vscode/
*.log
